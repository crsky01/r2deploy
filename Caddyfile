{$DOMAIN}, www.{$DOMAIN} {
  reverse_proxy app:3000
  encode gzip
}

z2ios.com, www.z2ios.com {
  reverse_proxy z2-app:3000
  encode gzip
}

k2ios.com, www.k2ios.com {
  reverse_proxy k2-app:3000
  encode gzip
}

:8080 {
  handle_path /rest/v1/* {
    reverse_proxy postgrest:3000
  }
  respond 404
}

:8081 {
  handle_path /rest/v1/* {
    reverse_proxy z2-postgrest:3000
  }
  respond 404
}

:8082 {
  handle_path /rest/v1/* {
    reverse_proxy k2-postgrest:3000
  }
  respond 404
}
